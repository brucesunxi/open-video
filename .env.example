# 本地默认只监听 127.0.0.1。复制为 .env；密钥只在后端使用。
DATA_DIR=./data
APP_HOST=127.0.0.1
APP_PORT=8010
# 远程部署必须配置访问令牌，通过页面登录；不要公开无认证端口。
APP_TOKEN=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=
# TTS/ASR 是本项目定义的 HTTP 适配协议，见 docs/model-services.md。
TTS_BASE_URL=
TTS_API_KEY=
ASR_BASE_URL=
ASR_API_KEY=
AVATAR_BASE_URL=
NODE_BINARY=node
# 共享账号模式：通过 scripts/set-account.py 设置。APP_TOKEN 此时仅用作内部会话签名密钥。
APP_USERNAME=admin
APP_PASSWORD_HASH=
APP_COOKIE_SECURE=0
